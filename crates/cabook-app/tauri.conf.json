{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CABook",
  "version": "0.1.1",
  "identifier": "com.fathforce.cabook",
  "build": {
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "CABook",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 500,
        "maximized": false,
        "decorations": false,
        "additionalBrowserArgs": "--renderer-process-limit=1 --disable-features=Translate,OptimizationHints,MediaRouter --disable-gpu-shader-disk-cache"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https://www.youtube-nocookie.com https://gcc.cecepazhar.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
